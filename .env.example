# ===== Nexora backend environment (example) =====
# Real values sirf apne local .env ya Heroku Config Vars mein rakho.
# Is file ko commit karna safe hai — sirf placeholders hain.

# App
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
APP_NAME=Nexora
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFY_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
BCRYPT_ROUNDS=12

# CORS (comma-separated origins; production mein required)
# CORS_ORIGINS=https://nexora.example.com,https://app.nexora.example.com
CORS_ORIGINS=

# Email verification/password reset links (optional, web client aane par)
# EMAIL_LINK_BASE_URL=https://nexora.example.com
EMAIL_LINK_BASE_URL=

# ===== PostgreSQL (primary source of truth) =====
# Heroku: apne Heroku Postgres add-on ka URL
# DATABASE_URL=postgres://user:password@host:5432/nexora
DATABASE_URL=

# ===== Redis (realtime state, rate limits, Socket.IO scaling) =====
# Heroku: Redis add-on ya external managed Redis
# REDIS_URL=redis://user:password@host:6379
REDIS_URL=

# ===== Auth secrets (kam az kam 32 random characters) =====
# JWT_ACCESS_SECRET=<generate-random-32+>
# JWT_REFRESH_SECRET=<generate-random-32+>
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Legacy keys (existing code JWT_SECRET bhi parhta hai)
# JWT_SECRET=<same-as-access>
JWT_SECRET=

# ===== FCM push (firebase-admin) =====
# Zaroori hai warna push notifications sirf log hoti hain (devices ko kuch nahi milta).
# Do forms mein se ek:
#  1. Inline JSON string (Heroku Config Vars ke liye asan) — Firebase Console →
#     Project settings → Service accounts → Generate new private key, phir poora
#     JSON content isi value mein paste karo.
#  2. File path (local dev) — service account JSON backend root mein rakho.
# FIREBASE_SERVICE_ACCOUNT=<inline-json OR ./firebase-adminsdk-xxx.json>
FIREBASE_SERVICE_ACCOUNT=

# ===== Email delivery: Google Gmail SMTP (initial provider) =====
# Gmail ke liye: 2-Step Verification ON karo, phir App Password banao.
# Normal Gmail password kabhi use mat karo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@gmail.com
SMTP_PASS=<google-app-password>
SMTP_FROM="Nexora <sender@gmail.com>"

# ===== Legacy (existing prototype) =====
# MONGO_URI=<legacy-mongodb-uri>
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BUCKET=
