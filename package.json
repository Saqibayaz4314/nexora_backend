{
  "name": "nexora_backend",
  "version": "1.0.0",
  "description": "Nexora - secure realtime messenger backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "check": "node --check src/server.js && node --check src/app.js",
    "cleanup:media": "node scripts/cleanup-media.js",
    "cleanup:calls": "node scripts/cleanup-calls.js",
    "cleanup:status": "node scripts/cleanup-status.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pg-mem": "^2.9.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
